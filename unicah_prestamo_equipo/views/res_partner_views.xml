<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_prestamo" model="ir.ui.view">
        <field name="name">res.partner.form.prestamo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_ver_prestamos" type="object"
                        class="oe_stat_button" icon="fa-laptop">
                    <field name="prestamo_count" widget="statinfo" string="Préstamos"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
